<div class="review-form">
  <h3>Add your Review</h3>

  <%= simple_form_for [list, review] do |f| %>
    <%= f.error_notification %>

    <div class="form-inputs">
      <%= f.input :rating,
          collection: 1..5,
          as: :radio_buttons,
          item_wrapper_class: 'rating-option',
          label: "Your Rating" %>

      <%= f.input :content,
          as: :text,
          placeholder: "Tell us what you thought about this movie collection...",
          input_html: { rows: 4, class: "form-control" } %>
    </div>

    <div class="form-actions">
      <%= f.button :submit, "Submit Review", class: "btn-review" %>
    </div>
  <% end %>
</div>
