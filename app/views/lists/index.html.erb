<%= image_tag"banner.jpg",
 alt: "Create your favourite watchlist", class: "banner" %>

<div class="container">
  <header>
    <h2 class="title">My List</h2>
    <%= link_to "Create a movie list", new_list_path %>
  </header>

  <div class="cards">
    <% @lists.each do |list| %>
        <div class="card">
          <%= link_to list_path(list), class: "card-link" do %>
          <%# card image %>
            <div class="card-image">
              <% if list.image_url.present? %>
                <%= image_tag list.image_url, alt: list.name %>
              <% else %>
                <div class="placeholder-image">
                  <span>No image</span>
                </div>
              <% end %>
            </div>
            <%# card title %>
            <div class="card-content">
              <h2><%= list.name.capitalize %></h2>
            </div>
          <% end %>
          <div class="card-action">
            <%= link_to "Delete", remove_list_path(list),
              data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
    <% end %>
  </div>

</div>
