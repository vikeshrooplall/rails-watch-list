<%# display success or error message for deleting a bookmark %>
<% if notice %>
  <div class="alert alert-success">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
<% if alert %>
  <div class="alert alert-danger">
    <%= alert %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<h2><%= @list.name %></h2>
<%# Bookmark details %>
<ul>
  <% @list.bookmarks.each do |bookmark| %>
    <li>
      <strong><%= bookmark.movie.title %><br></strong>
      <p>Comment: <%= bookmark.comment %> </p>
    </li>
    <%= link_to "remove", bookmark_path(bookmark),
      data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}%>

  <% end %>
</ul>
<%# buttons %>
<%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
<%= link_to "Back to lists", lists_path %>
